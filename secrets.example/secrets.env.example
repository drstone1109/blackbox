# ==============================================================
# SECRETS TEMPLATE (Safe to commit to GitHub)
# Copy this file to `secrets/secrets.env` (which is git-ignored)
# and fill in your real credentials and phone numbers.
# ==============================================================

# Meta WhatsApp Cloud API Credentials
WHATSAPP_TOKEN=EAAG...YOUR_REAL_META_ACCESS_TOKEN_HERE
PHONE_NUMBER_ID=123456789012345
META_API_VERSION=v21.0

# Webhook Verification Token
VERIFY_TOKEN=my_secure_custom_webhook_secret_2026

# Authorized Phone Numbers (comma-separated with country code, or * for all)
OWNER_PHONE_NUMBERS=+1234567890,+919876543210
