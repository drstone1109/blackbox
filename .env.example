# ==============================================================
# General WhatsApp Inventory ERP (Level 0) - Configuration
# ==============================================================

# Application Environment (development / production)
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Meta WhatsApp Cloud API Credentials
# Obtain from developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_TOKEN=EAAG...YOUR_ACCESS_TOKEN_HERE
PHONE_NUMBER_ID=123456789012345
META_API_VERSION=v21.0

# Webhook Verification Token (Choose any random secure secret string)
# You must enter this exact same token in the Meta App Webhooks setup
VERIFY_TOKEN=blackbox_inventory_token_2026

# Access Control (Phone Numbers)
# Comma-separated list of authorized WhatsApp phone numbers with country code (e.g., +12345678901,+919876543210)
# Set to "*" to allow any sender during testing/development
OWNER_PHONE_NUMBERS=*

# SQLite Database File Path
DATABASE_PATH=inventory.db

# Business Rules
DEFAULT_MIN_ALERT_QTY=5
