[Unit]
Description=Blackbox ERP Production Service
After=network.target

[Service]
User=%i
WorkingDirectory=/home/%i/blackbox
ExecStart=/home/%i/blackbox/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=APP_ENV=production

[Install]
WantedBy=multi-user.target

